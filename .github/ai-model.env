# Single source for the deploy-time AI model configuration (ADR-0008, plan item W9).
# Every workflow that talks to the provider loads this file into $GITHUB_ENV before it deploys or
# evaluates (step "Load AI model configuration"); backend/app/config.py carries the same defaults for
# local runs, and backend/tests/unit/test_retired_model_ids.py fails if the two ever diverge or a
# workflow carries its own literal. Change the model here and in config.py, nowhere else.
AI_DEFAULT_MODEL=deepseek-flash
OPENAI_BASE_URL=https://api.deepseek.com/v1
