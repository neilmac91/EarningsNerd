diff --git a/frontend/features/analysis/components/QuietDataNotes.tsx b/frontend/features/analysis/components/QuietDataNotes.tsx
new file mode 100644
index 000000000..add57ed26
--- /dev/null
+++ b/frontend/features/analysis/components/QuietDataNotes.tsx
@@ -0,0 +1,47 @@
+'use client'
+
+import type { AnalysisDataset } from '@/features/analysis/api/analysis-api'
+import type { DataNote } from '@/features/analysis/lib/dataNotes'
+import { formatAnalysisPeriod } from '@/features/analysis/lib/periodLabels'
+import { isSilentNote } from '@/features/analysis/lib/notationVariant'
+import { useDataNotes } from './DataNotesContext'
+
+/** Prototype copy (docs/mpa-improvements/coherence.md §2): one sentence per reason, the reader's words. */
+const QUIET_COPY: Record<string, string> = {
+  source_conflict: 'Restated in a later filing: the year’s own annual report gave a different value. We show the later filing’s value; select one to see both filings.',
+  legacy_calculation: 'Calculated before 10 October 2026, when we began keeping each calculation’s inputs; shown as stored, with its inputs not linked.',
+  not_in_dataset: 'Not in our data for these periods; shown as —, never as zero.',
+}
+const copy = (note: DataNote) => note.reasons.every((reason) => QUIET_COPY[reason]) ? note.reasons.map((reason) => QUIET_COPY[reason]).join(' ') : note.message
+
+function places(values: DataNote['values']) {
+  const periods = new Map<string, string[]>()
+  for (const value of values) periods.set(value.label, [...(periods.get(value.label) ?? []), value.period])
+  return [...periods].map(([label, keys]) => `${label} ${[...new Set(keys)].map((key) => formatAnalysisPeriod(key)).join(', ')}`).join('; ')
+}
+
+/** Fine print under the table: a mark on the page only where the number itself is in question. */
+export default function QuietDataNotes({ dataset }: { dataset: AnalysisDataset }) {
+  const model = useDataNotes(dataset)
+  const marked = model.notes.filter((note) => !isSilentNote(note) && note.values.length > 0)
+  const gaps = model.notes.filter((note) => note.kind === 'unavailable').reduce((count, note) => count + note.values.length, 0)
+  const calculated = model.totals.calculated
+  return (
+    <section className="min-w-0 text-xs leading-relaxed text-text-secondary-light dark:text-text-secondary-dark" data-analysis-data-notes>
+      <details>
+        <summary className="cursor-pointer rounded py-1 focus-visible:outline-none focus-visible:shadow-ring-brand dark:focus-visible:shadow-ring-brand-dark">
+          <span className="font-medium text-text-primary-light dark:text-text-primary-dark">Data notes</span>
+          {marked.map((note) => <span key={note.key}> · <sup className="font-data">{note.letter}</sup> {places(note.values)}: restated in a later filing; we show the later value</span>)}
+          {gaps > 0 && <span> · {gaps} not in our data, shown as —</span>}
+          {calculated > 0 && <span> · {calculated} calculated from filed figures</span>}
+        </summary>
+        <div className="space-y-2 pb-2 pt-1">
+          {model.notes.map((note) => <p key={note.key} id={note.id} tabIndex={-1} className="rounded focus-visible:outline-none focus-visible:shadow-ring-brand dark:focus-visible:shadow-ring-brand-dark">
+            {!isSilentNote(note) && <span className="font-data">{note.letter}. </span>}{copy(note)} {places(note.values)}.
+          </p>)}
+          <p>Select any figure to see its source filing, method and inputs. Automated checks confirm that reported figures come from the company’s filed data (XBRL); they are not an audit of the company’s accounts.</p>
+        </div>
+      </details>
+    </section>
+  )
+}
diff --git a/frontend/features/analysis/lib/notationVariant.ts b/frontend/features/analysis/lib/notationVariant.ts
new file mode 100644
index 000000000..bf72d8263
--- /dev/null
+++ b/frontend/features/analysis/lib/notationVariant.ts
@@ -0,0 +1,11 @@
+import type { DataNote } from '@/features/analysis/lib/dataNotes'
+
+/** Prototype switch (docs/mpa-improvements): current marks, the quiet scheme, or no marks at all. */
+export const NOTATION_VARIANT = (process.env.NEXT_PUBLIC_NOTATION_VARIANT ?? 'current') as 'current' | 'quiet' | 'none'
+
+/** Quiet: only a concern about the number itself earns a mark; calculation, record gaps and absences stay in the evidence and the fine print. */
+export function isSilentNote(note: Pick<DataNote, 'kind' | 'reasons'>) {
+  if (NOTATION_VARIANT === 'current') return false
+  if (NOTATION_VARIANT === 'none') return true
+  return note.kind !== 'review' || note.reasons.every((reason) => reason === 'legacy_calculation')
+}
