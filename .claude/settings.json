{
  "permissions": {
    "allow": [
      "Bash(gh workflow run ops.yml -R neilmac91/EarningsNerd --ref main -f operation=describe-service)",
      "Bash(gh workflow run ops.yml -R neilmac91/EarningsNerd --ref main -f operation=logs-probe)",
      "Bash(gh run list -R neilmac91/EarningsNerd --workflow ops.yml --branch main --event workflow_dispatch -L 5 --json databaseId,status,conclusion,createdAt,headSha)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret_scan_guard.py\" --session-start || exit 1",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__.*[Gg][Ii][Tt][Hh][Uu][Bb].*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"$CLAUDE_PROJECT_DIR/.claude/hooks/codex_mention_guard.py\" || exit 1",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|mcp__.*[Gg][Ii][Tt][Hh][Uu][Bb].*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret_scan_guard.py\" || exit 1",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -S \"$CLAUDE_PROJECT_DIR/.claude/hooks/ops_approval_guard.py\" || exit 1",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "effortLevel": "high",
  "ultracode": false,
  "workflowSizeGuideline": "small"
}
