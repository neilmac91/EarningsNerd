# EarningsNerd frontend — example environment file.
# Copy to `.env.local` and adjust:  cp .env.local.example .env.local
# Defaults work for local dev against a backend on http://localhost:8000.

# Base URL of the backend API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Analytics (optional). Leave blank to disable PostHog locally.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Error tracking (optional). Client + server DSN for Sentry.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Sentry source-map upload (BUILD-time only; set in Vercel, not needed locally). All three are
# required together; when unset the build logs a warning, skips the upload, and still succeeds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Feature flags. Each is off unless set to "true", except RECOMMENDED_FILING and FEEDBACK_WIDGET,
# which are on unless set to "false" (lib/featureFlags.ts).
NEXT_PUBLIC_ENABLE_FINANCIAL_CHARTS=false
NEXT_PUBLIC_ENABLE_QUALITY_BADGE=false
NEXT_PUBLIC_ENABLE_RECOMMENDED_FILING=true
# NEXT_PUBLIC_ENABLE_FEEDBACK_WIDGET=true
# NEXT_PUBLIC_ENABLE_CALENDAR=false
# NEXT_PUBLIC_ENABLE_INSIDER_ACTIVITY=false
# NEXT_PUBLIC_ENABLE_FULLTEXT_SEARCH=false
# Set in lockstep with the backend's PRO_TRIAL_DAYS.
# NEXT_PUBLIC_ENABLE_PRO_TRIAL=false
# Local prototypes (direct routes 404 while off).
# NEXT_PUBLIC_ENABLE_RESEARCH_EVIDENCE_PACKS=false
# NEXT_PUBLIC_ENABLE_FILING_REDLINES=false
# NEXT_PUBLIC_ENABLE_FINANCIAL_REFRESH_REVIEW=false
# Sign in with Apple button (backend Apple exchange + Apple Developer setup must be live first).
NEXT_PUBLIC_ENABLE_APPLE_SIGNIN=false
# Multi-Period Analysis (Pro flagship: /analysis route, nav entry, watchlist CTA). Ships dark
# until the backend is verified in prod and the companyfacts cache is warmed; when off the route
# 404s so direct URLs are hidden too.
NEXT_PUBLIC_ENABLE_ANALYSIS=false
NEXT_PUBLIC_ENABLE_FPI_FILINGS=false

# Cloudflare Turnstile (bot defense) site key. When set, the Turnstile widget renders on the
# login/register/contact/waitlist forms. The backend must also have TURNSTILE_SECRET_KEY set —
# until BOTH are configured, the widget renders nothing and verification is a no-op.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Filing id used by the homepage "example summary" link (optional).
NEXT_PUBLIC_EXAMPLE_FILING_ID=

# Logo.dev publishable token for company logos (CompanyLogo.tsx). Safe to expose
# client-side — it's a publishable key, not a secret. Free tier: logo.dev/pricing.
# Leave blank to always show the initials-monogram fallback (no broken images).
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# Waitlist/pre-launch gating (server-side). true = waitlist mode on.
WAITLIST_MODE=false
