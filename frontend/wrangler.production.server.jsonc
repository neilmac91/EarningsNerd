// The Cloudflare Workers PRODUCTION frontend, server Worker (cloudflare-server.mjs): the Next server behind
// wrangler.production.jsonc, as wrangler.server.jsonc is behind staging's front Worker. It has no hostname and no
// workers.dev address, before the cutover and after it. docs/DEPLOYMENT.md, "Moving production to Cloudflare
// Workers". Keep each comment on a line of its own: tests/unit/cloudflareWorkerConfig.spec.ts drops those lines.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earningsnerd-frontend-server",
  "main": "cloudflare-server.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // Beside the API on Cloud Run in us-west1, as Vercel's functions are (vercel.json `regions`).
  "placement": { "region": "gcp:us-west1" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "earningsnerd-frontend" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "earningsnerd-frontend-cache" }],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler", "script_name": "earningsnerd-frontend" }]
  }
}
